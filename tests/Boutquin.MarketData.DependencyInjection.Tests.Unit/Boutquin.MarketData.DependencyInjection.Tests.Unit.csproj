<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Boutquin.MarketData.DependencyInjection.Tests.Unit</AssemblyName>
    <RootNamespace>Boutquin.MarketData.DependencyInjection.Tests.Unit</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Concrete logging package, TEST-ONLY (IsPackable=false): AC-1.8's primary assertions must
         compose logging the way a production host does — services.AddLogging(b => b.AddProvider(…))
         — which lives here, not in .Abstractions. No src/ project references it; the kernel keeps
         resolving through .Abstractions only. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Boutquin.MarketData.DependencyInjection/Boutquin.MarketData.DependencyInjection.csproj" />
  </ItemGroup>
</Project>
