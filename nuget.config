<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Boutquin.Storage.Domain" />
      <package pattern="Boutquin.Storage.Infrastructure" />
      <package pattern="Boutquin.Storage.SourceGenerator" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
