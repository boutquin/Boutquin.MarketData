<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Boutquin.MarketData.Calendars</PackageId>
    <AssemblyName>Boutquin.MarketData.Calendars</AssemblyName>
    <RootNamespace>Boutquin.MarketData.Calendars</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- Calendar-only compatibility packs can retain a consumer's existing abstractions ABI. -->
  <ItemGroup Condition="'$(CalendarAbstractionsPackageVersion)' == ''">
    <ProjectReference Include="..\Boutquin.MarketData.Abstractions\Boutquin.MarketData.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CalendarAbstractionsPackageVersion)' != ''">
    <PackageReference Include="Boutquin.MarketData.Abstractions" VersionOverride="$(CalendarAbstractionsPackageVersion)" />
  </ItemGroup>
</Project>
