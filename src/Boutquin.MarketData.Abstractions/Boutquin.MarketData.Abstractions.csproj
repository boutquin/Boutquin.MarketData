<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Boutquin.MarketData.Abstractions</PackageId>
    <AssemblyName>Boutquin.MarketData.Abstractions</AssemblyName>
    <RootNamespace>Boutquin.MarketData.Abstractions</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 (missing XML doc) is suppressed here because the Boutquin.Storage 2.0 source
      generators emit undocumented public serialization plumbing — ISerializable<T>
      (Serialize/Deserialize/CompareTo/comparison operators) for every [Key] DatasetKey and
      [StorageSerializable] record, and IColumnarRehydratable<T> (Rehydrate) for every
      [ColumnarStorable] record — into `<auto-generated>` .g.cs files. Those members are
      generated, not hand-authored, so they carry no XML doc; the hand-authored public surface
      (the positional records / keys themselves) is documented via <summary>/<param>. The
      real public-API surface is tracked separately by the PublicAPI analyzer (RS0016/RS0017).
      Hand-authored members in this project are still doc-checked by the documentation-style
      build gate at review time. Scoped to this project — it is the only /src/ project that
      consumes the Storage source generator.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Project references -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Boutquin.Domain" />
    <PackageReference Include="Boutquin.Storage.Domain" />
    <!-- Analyzer-only reference: the generator emits ISerializable<T> / IColumnarSegmentFormat<T>
         at build time for types annotated [StorageSerializable] / [ColumnarStorable]. No runtime
         assembly flows to consumers. -->
    <PackageReference Include="Boutquin.Storage.SourceGenerator" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>
</Project>
